PORT=8787
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Production / Railway default — TikTok Live feed only (no TikLeap)
SCRAPE_MODE=tiktok_feed
# UK residential HTTP proxy for Railway Chromium (required for reliable GB keepers).
# user:pass is supported via a local CONNECT forwarder (Chromium ignores credentials
# in --proxy-server). Prefer HTTP over SOCKS5. URL-encode special chars (@ → %40).
# SCRAPE_PROXY=http://user:pass_country-gb@geo.iproyal.com:12321
# LEAD_FINDER_PROXY=http://user:pass@host:8080
# Optional: longer Live navigate when proxy is set (default 90000)
# SCRAPE_PROXY_NAVIGATE_TIMEOUT_MS=90000
# Optional local TikLeap priority pipeline (headed Chrome + Premium cookies)
# ENABLE_TIKLEAP=1
# SCRAPE_MODE=full
# Set on HTTPS deploys so auth cookies use Secure
# COOKIE_SECURE=1
# LEAD_FINDER_CHROME_PATH=/usr/bin/chromium

# Early access form (POST /api/early-access → save + optional email)
# EARLY_ACCESS_TO=jamiemathieson5@gmail.com
#
# Recommended (no Gmail login): Resend API key only — https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# Optional From (defaults to CreatorRadar <onboarding@resend.dev> until you verify a domain)
# RESEND_FROM="CreatorRadar <onboarding@resend.dev>"
# EARLY_ACCESS_FROM="CreatorRadar <you@yourdomain.com>"
#
# Optional Gmail path — NOT your normal Gmail password:
#   GMAIL_USER = just the email address (public-ish)
#   GMAIL_APP_PASSWORD = 16-character App Password from Google Account → Security →
#   2-Step Verification → App passwords (revocable anytime). Never use the account password.
# GMAIL_USER=your@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Or generic SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
#
# Submissions always append to data/early-access.json and show on the admin dashboard
# even when no email provider is configured.
