PORT=8787
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Production / Railway default — TikTok Live feed only (no TikLeap)
SCRAPE_MODE=tiktok_feed
# UK residential proxy for Railway Chromium (required for reliable GB keepers).
# user:pass in the URL is supported (CDP handles 407 auth; do not rely on
# --proxy-server alone). URL-encode special chars in credentials (@ → %40).
# SCRAPE_PROXY=http://user:pass_country-gb@geo.iproyal.com:12321
# LEAD_FINDER_PROXY=socks5://user:pass@host:1080
# Optional: longer Live navigate when proxy is set (default 90000)
# SCRAPE_PROXY_NAVIGATE_TIMEOUT_MS=90000
# Optional local TikLeap priority pipeline (headed Chrome + Premium cookies)
# ENABLE_TIKLEAP=1
# SCRAPE_MODE=full
# Set on HTTPS deploys so auth cookies use Secure
# COOKIE_SECURE=1
# LEAD_FINDER_CHROME_PATH=/usr/bin/chromium
